build/

# Ignore all processed data and intermediate network files
data/processed/**/*
# Prevent ignoring the .gitkeep file so the folder structure is kept
!data/processed/.gitkeep

# Ignore all final analysis results, plots, and outputs
data/results/**/*
# Prevent ignoring the .gitkeep file so the folder structure is kept
!data/results/.gitkeep